# ── Plantilla de variables de entorno ─────────────────────────────
# Copiá este archivo como ".env" y completá los valores:
#   cp .env.example .env       (Git Bash / Linux / Mac)
#   copy .env.example .env     (Windows CMD)
#
# Este archivo SÍ se commitea. El ".env" real NO (está en .gitignore).

# URL base de la API principal (sin trailing slash final antes de /api)
VITE_API_BASE_URL=

# URL base de la API de autenticación
VITE_AUTH_API_URL=