# ── Modo: npm run dev ────────────────────────────────────
# Vite dev server con proxies: el navegador llama a /api y /auth-api,
# y Vite los redirige a las APIs locales (definido en vite.config.js).
# Esto evita problemas de CORS durante el desarrollo.

VITE_API_BASE_URL=/api
VITE_AUTH_API_URL=/auth-api
